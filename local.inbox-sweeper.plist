<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.inbox-sweeper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/USERNAME/bin/inbox-sweeper.sh</string>
        <string>/Users/USERNAME/DIRECTORY</string>
    </array>

    <!-- Every hour, plus once at login/load -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/inbox-sweeper.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/inbox-sweeper.log</string>
</dict>
</plist>
